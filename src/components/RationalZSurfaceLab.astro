  .list-actions{display:flex;gap:.4rem}.mode-presets{margin-top:1rem;padding-top:1rem;border-top:1px solid var(--sl-color-gray-5)}.mode-presets p{margin:.2rem 0 .65rem;color:var(--sl-color-gray-2);font-size:.8rem}.preset-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}.preset-grid button{text-align:left;font-size:.78rem}
