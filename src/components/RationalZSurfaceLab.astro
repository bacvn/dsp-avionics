---
const id = `rational-z-${Math.random().toString(36).slice(2)}`;
---

<section class="rz-lab" id={id}>
  <header class="rz-header">
    <div>
      <span class="eyebrow">POLE–ZERO SURFACE LAB</span>
      <h2>Tạo X(z), rồi quan sát zero và pole biến dạng bề mặt</h2>
    </div>
    <div class="legend" aria-label="Chú giải">
      <span><i class="zero-mark"></i> Zero</span>
      <span><i class="pole-mark">×</i> Pole</span>
      <span><i class="unit-mark"></i> |z| = 1</span>
    </div>
  </header>

  <div class="rz-layout">
    <section class="rz-panel editor-panel" aria-labelledby={`${id}-editor-title`}>
      <div class="panel-title">
        <div><span class="panel-index">01</span><h3 id={`${id}-editor-title`}>Đặt zero và pole</h3></div>
        <span class="hint">Click để thêm · kéo để di chuyển</span>
      </div>

      <div class="plane-wrap">
        <canvas data-plane width="720" height="720" tabindex="0" role="img" aria-label="Mặt phẳng z tương tác. Click để thêm zero hoặc pole, kéo một điểm để di chuyển."></canvas>
        <form class="point-menu" data-point-menu hidden>
          <strong>Thêm tại <span data-menu-coordinate></span></strong>
          <label>Loại
            <select data-menu-type><option value="zero">Zero ○</option><option value="pole">Pole ×</option></select>
          </label>
          <label>Bậc
            <select data-menu-order>
              <option value="1">1 — đơn</option><option value="2">2 — kép</option>
              <option value="3">3</option><option value="4">4</option><option value="5">5</option>
            </select>
          </label>
          <div class="menu-actions">
            <button type="submit" class="primary">Thêm</button>
            <button type="button" data-menu-cancel>Hủy</button>
          </div>
        </form>
      </div>

      <form class="manual-form" data-manual-form>
        <div class="form-heading">
          <strong>Nhập điểm bằng tay</strong>
          <span>z = a + jb</span>
        </div>
        <div class="manual-grid">
          <label>Loại<select data-manual-type><option value="zero">Zero</option><option value="pole">Pole</option></select></label>
          <label>Re<input data-manual-re type="number" step="0.01" min="-2" max="2" value="0.5" required /></label>
          <label>Im<input data-manual-im type="number" step="0.01" min="-2" max="2" value="0" required /></label>
          <label>Bậc<input data-manual-order type="number" step="1" min="1" max="9" value="1" required /></label>
          <button class="primary" type="submit">Thêm điểm</button>
        </div>
      </form>

      <div class="point-list-heading">
        <strong>Danh sách điểm</strong>
        <div class="list-actions">
          <button type="button" data-clear-zeros>Xóa mọi zero</button>
          <button type="button" data-clear>Xóa tất cả</button>
        </div>
      </div>
      <div class="point-list" data-point-list aria-live="polite"></div>

      <div class="mode-presets">
        <strong>Preset khảo sát mode của pole</strong>
        <p>Mỗi preset xóa zero để chỉ giữ ảnh hưởng tự nhiên của pole.</p>
        <div class="preset-grid">
          <button type="button" data-preset="positive">Thực dương · tắt dần</button>
          <button type="button" data-preset="negative">Thực âm · đổi dấu</button>
          <button type="button" data-preset="complex">Phức · dao động</button>
          <button type="button" data-preset="unit">Trên |z| = 1</button>
          <button type="button" data-preset="outside">Ngoài |z| = 1</button>
          <button type="button" data-preset="repeated">Cực bội</button>
        </div>
      </div>
    </section>

    <section class="rz-panel surface-panel" aria-labelledby={`${id}-surface-title`}>
      <div class="panel-title surface-title-row">
        <div><span class="panel-index">02</span><h3 id={`${id}-surface-title`}>Bề mặt biên độ của X(z)</h3></div>
        <div class="surface-actions">
          <output data-view-state aria-live="polite">Góc mặc định</output>
          <button type="button" data-reset-view>Đặt lại góc nhìn</button>
        </div>
      </div>

      <div class="lab-options">
        <label>Loại hệ
          <select data-system-type>
            <option value="real">Hệ thực — tự thêm liên hợp</option>
            <option value="complex">Hệ phức — điểm tự do</option>
          </select>
        </label>
        <div class="resolution-control">
          <span>Độ phân giải 3D</span>
          <button type="button" data-resolution-down aria-label="Giảm độ phân giải">−</button>
          <output data-resolution aria-live="polite">35 × 35</output>
          <button type="button" data-resolution-up aria-label="Tăng độ phân giải">+</button>
        </div>
      </div>

      <div class="surface-wrap">
        <canvas data-surface width="1120" height="760" tabindex="0" role="img" aria-label="Bề mặt ba chiều của 20 logarit cơ số 10 trị tuyệt đối X của z. Kéo để xoay góc nhìn."></canvas>
        <div class="rotate-hint">Kéo để xoay · phím mũi tên cũng xoay được</div>
      </div>
      <div class="color-scale" aria-hidden="true"><span>−36 dB · zero</span><i></i><span>+36 dB · pole</span></div>

      <div class="equation" aria-live="polite">
        <div class="factor-form"><span>X(z) =</span><span class="fraction"><span data-numerator></span><span data-denominator></span></span></div>
        <div class="polynomials"><span data-b-poly></span><span data-a-poly></span></div>
      </div>
      <p class="surface-note">Bề mặt biểu diễn <strong>20 log₁₀|X(z)|</strong>, giới hạn trong khoảng −36 đến +36 dB để zero và pole vẫn quan sát được.</p>
    </section>

    <section class="rz-panel impulse-panel" aria-labelledby={`${id}-impulse-title`}>
      <div class="panel-title impulse-title-row">
        <div><span class="panel-index">03</span><h3 id={`${id}-impulse-title`}>Đáp ứng xung h[n] — stem plot</h3></div>
        <label class="sample-control">Số mẫu
          <input data-sample-count type="number" min="12" max="96" step="4" value="40" />
        </label>
      </div>
      <div class="mode-summary" data-mode-summary aria-live="polite"></div>
      <div class="stem-wrap">
        <canvas data-stem width="1120" height="520" tabindex="0" role="img" aria-label="Stem plot của đáp ứng hệ thống khi đầu vào là xung đơn vị."></canvas>
      </div>
      <div class="stem-legend" aria-hidden="true"><span><i class="real-sample"></i> Re&#123;h[n]&#125;</span><span><i class="imag-sample"></i> Im&#123;h[n]&#125;</span></div>
      <p class="surface-note">Giả thiết hệ <strong>nhân quả</strong>, ROC nằm ngoài pole có bán kính lớn nhất. Đồ thị dùng H(z) ở dạng lũy thừa z⁻¹ và đầu vào là xung đơn vị δ[n].</p>
    </section>
  </div>
</section>

<script define:vars={{ id }}>
  const root = document.getElementById(id);
  const plane = root.querySelector('[data-plane]');
  const surface = root.querySelector('[data-surface]');
  const stem = root.querySelector('[data-stem]');
  const pointMenu = root.querySelector('[data-point-menu]');
  const pointList = root.querySelector('[data-point-list]');
  const domain = 1.6;
  const defaultYaw = -0.72;
  const defaultPitch = 0.83;
  let points = [
    { id: 1, group: 1, type: 'zero', re: -0.55, im: 0, order: 1 },
    { id: 2, group: 2, type: 'pole', re: 0.68, im: 0.48, order: 1 },
    { id: 3, group: 2, type: 'pole', re: 0.68, im: -0.48, order: 1 },
  ];
  let nextId = 4;
  let nextGroup = 3;
  let realSystem = true;
  let resolution = 35;
  let pending = null;
  let draggedId = null;
  let yaw = defaultYaw;
  let pitch = defaultPitch;
  let surfaceDrag = null;
  let sampleCount = 40;

  const css = (name, fallback) => getComputedStyle(root).getPropertyValue(name).trim() || fallback;
  const fitCanvas = (canvas) => {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const width = Math.max(1, Math.round(rect.width * dpr));
    const height = Math.max(1, Math.round(rect.height * dpr));
    if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
    return { ctx: canvas.getContext('2d'), width, height, dpr };
  };
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const clean = (v) => Math.abs(v) < 0.005 ? 0 : Math.round(v * 100) / 100;
  const mateOf = (p) => points.find((q) => q.id !== p.id && q.group === p.group);
  function syncPair(p) {
    if (!realSystem) return;
    const mate = mateOf(p);
    if (Math.abs(p.im) < 0.005) {
      p.im = 0;
      if (mate) points = points.filter((q) => q.id !== mate.id);
      return;
    }
    if (mate) Object.assign(mate, { type:p.type, re:p.re, im:-p.im, order:p.order });
    else points.push({ id:nextId++, group:p.group, type:p.type, re:p.re, im:-p.im, order:p.order });
  }
  function addPoint(type, re, im, order) {
    const p = { id:nextId++, group:nextGroup++, type, re:clean(clamp(re,-domain,domain)), im:clean(clamp(im,-domain,domain)), order:clamp(Math.round(order),1,9) };
    points.push(p); syncPair(p);
  }
  function enforceRealSystem() {
    const originals = [...points];
    const used = new Set();
    for (const p of originals) {
      if (used.has(p.id)) continue;
      if (Math.abs(p.im) < .005) { p.im=0; p.group=nextGroup++; used.add(p.id); continue; }
      const mate = originals.find((q) => !used.has(q.id) && q.id!==p.id && q.type===p.type && q.order===p.order && Math.abs(q.re-p.re)<.005 && Math.abs(q.im+p.im)<.005);
      p.group=nextGroup++; used.add(p.id);
      if (mate) { mate.group=p.group; used.add(mate.id); }
      else points.push({id:nextId++,group:p.group,type:p.type,re:p.re,im:-p.im,order:p.order});
    }
  }
  const planeCoord = (event) => {
    const rect = plane.getBoundingClientRect();
    const side = Math.min(rect.width, rect.height);
    const pad = side * 0.085;
    const span = side - pad * 2;
    return {
      re: clean(clamp(((event.clientX - rect.left - pad) / span * 2 - 1) * domain, -domain, domain)),
      im: clean(clamp((1 - (event.clientY - rect.top - pad) / span * 2) * domain, -domain, domain)),
    };
  };
  const pointPixel = (p, width, height) => {
    const side = Math.min(width, height), pad = side * 0.085, span = side - pad * 2;
    return { x: (width - side) / 2 + pad + (p.re / domain + 1) * span / 2, y: (height - side) / 2 + pad + (1 - p.im / domain) * span / 2 };
  };
  const eventPointHit = (event) => {
    const rect = plane.getBoundingClientRect();
    const sx = plane.width / rect.width, sy = plane.height / rect.height;
    const x = (event.clientX - rect.left) * sx, y = (event.clientY - rect.top) * sy;
    return [...points].reverse().find((p) => { const q = pointPixel(p, plane.width, plane.height); return Math.hypot(x-q.x, y-q.y) < 18 * sx; });
  };

  function drawPlane() {
    const { ctx, width, height, dpr } = fitCanvas(plane);
    const bg = css('--sl-color-bg', '#0b111c'), fg = css('--sl-color-text', '#e7edf7');
    const grid = css('--sl-color-gray-5', '#526076'), accent = css('--sl-color-accent', '#54d2d2');
    ctx.clearRect(0, 0, width, height); ctx.fillStyle = bg; ctx.fillRect(0, 0, width, height);
    const side = Math.min(width, height), pad = side * 0.085, span = side - pad * 2, ox = width/2, oy = height/2, scale = span/(2*domain);
    ctx.lineWidth = dpr; ctx.strokeStyle = grid; ctx.globalAlpha = 0.32;
    for (let v=-1.5; v<=1.501; v+=0.5) {
      const x=ox+v*scale, y=oy-v*scale;
      ctx.beginPath(); ctx.moveTo(x, oy-domain*scale); ctx.lineTo(x, oy+domain*scale); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(ox-domain*scale, y); ctx.lineTo(ox+domain*scale, y); ctx.stroke();
    }
    ctx.globalAlpha = 0.9; ctx.strokeStyle = fg; ctx.lineWidth = 1.4*dpr;
    ctx.beginPath(); ctx.moveTo(ox-domain*scale,oy); ctx.lineTo(ox+domain*scale,oy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(ox,oy-domain*scale); ctx.lineTo(ox,oy+domain*scale); ctx.stroke();
    ctx.setLineDash([7*dpr,6*dpr]); ctx.strokeStyle=accent; ctx.globalAlpha=.65; ctx.lineWidth=1.5*dpr;
    ctx.beginPath(); ctx.arc(ox,oy,scale,0,Math.PI*2); ctx.stroke(); ctx.setLineDash([]);
    ctx.globalAlpha=.92; ctx.fillStyle=accent; ctx.font=`600 ${12*dpr}px system-ui`; ctx.textAlign='left';
    ctx.fillText('Đường tròn đơn vị  |z| = 1',ox+scale*.42,oy-scale*.86);
    ctx.globalAlpha=.8; ctx.fillStyle=fg; ctx.font=`${12*dpr}px system-ui`; ctx.textAlign='center'; ctx.fillText('−1',ox-scale,oy+18*dpr); ctx.fillText('1',ox+scale,oy+18*dpr);
    ctx.textAlign='left'; ctx.fillText('Re{z}',ox+domain*scale-35*dpr,oy-9*dpr); ctx.fillText('Im{z}',ox+8*dpr,oy-domain*scale+14*dpr);
    points.forEach((p) => {
      const q=pointPixel(p,width,height), r=9*dpr;
      ctx.globalAlpha=1; ctx.lineWidth=3*dpr; ctx.strokeStyle=p.type==='zero'?accent:css('--sl-color-orange-high','#ff9d55');
      if (p.type==='zero') { ctx.fillStyle=bg; ctx.beginPath(); ctx.arc(q.x,q.y,r,0,Math.PI*2); ctx.fill(); ctx.stroke(); }
      else { ctx.beginPath(); ctx.moveTo(q.x-r,q.y-r); ctx.lineTo(q.x+r,q.y+r); ctx.moveTo(q.x+r,q.y-r); ctx.lineTo(q.x-r,q.y+r); ctx.stroke(); }
      if (p.order>1) { ctx.fillStyle=fg; ctx.font=`600 ${12*dpr}px system-ui`; ctx.fillText(String(p.order),q.x+12*dpr,q.y-12*dpr); }
    });
  }

  const logMagnitudeDb = (x,y) => {
    let ln=0;
    for (const p of points) ln += (p.type==='zero'?1:-1)*p.order*Math.log(Math.max(0.012,Math.hypot(x-p.re,y-p.im)));
    return clamp(20/Math.LN10*ln,-36,36);
  };
  const mix=(a,b,t)=>a.map((v,i)=>Math.round(v+(b[i]-v)*t));
  const surfaceColor=(t)=>{ const c=t<.5?mix([44,118,166],[57,205,183],t*2):mix([57,205,183],[245,126,66],(t-.5)*2); return `rgb(${c.join(',')})`; };
  function project3D(x,y,z,width,height) {
    const cy=Math.cos(yaw), sy=Math.sin(yaw), cp=Math.cos(pitch), sp=Math.sin(pitch);
    const xr=x*cy-y*sy, yr=x*sy+y*cy;
    const yr2=yr*cp-z*sp, zr=yr*sp+z*cp;
    const scale=Math.min(width*.31,height*.38);
    return { x:width*.5+xr*scale, y:height*.58-yr2*scale, depth:zr };
  }
  function drawSurface() {
    const {ctx,width,height,dpr}=fitCanvas(surface), bg=css('--sl-color-bg','#0b111c'), fg=css('--sl-color-text','#e7edf7'), grid=css('--sl-color-gray-5','#526076');
    ctx.clearRect(0,0,width,height); ctx.fillStyle=bg; ctx.fillRect(0,0,width,height);
    const n=resolution, cells=[];
    for(let j=0;j<n-1;j++) for(let i=0;i<n-1;i++) {
      const verts=[]; let avg=0;
      for(const [ii,jj] of [[i,j],[i+1,j],[i+1,j+1],[i,j+1]]) {
        const x=-domain+2*domain*ii/(n-1), y=-domain+2*domain*jj/(n-1), db=logMagnitudeDb(x,y), z=db/36*.75;
        verts.push(project3D(x/domain,y/domain,z,width,height)); avg+=db;
      }
      cells.push({verts,db:avg/4,depth:verts.reduce((s,v)=>s+v.depth,0)/4});
    }
    cells.sort((a,b)=>a.depth-b.depth);
    for(const cell of cells){ ctx.beginPath(); cell.verts.forEach((v,k)=>k?ctx.lineTo(v.x,v.y):ctx.moveTo(v.x,v.y)); ctx.closePath(); ctx.fillStyle=surfaceColor((cell.db+36)/72); ctx.globalAlpha=.88; ctx.fill(); ctx.strokeStyle=bg; ctx.globalAlpha=.22; ctx.lineWidth=.55*dpr; ctx.stroke(); }
    ctx.globalAlpha=.75; ctx.strokeStyle=grid; ctx.fillStyle=fg; ctx.lineWidth=1.2*dpr; ctx.font=`${12*dpr}px system-ui`;
    const axes=[[[0,0,-.75],[0,0,.88],'dB'],[[-1.12,0,-.75],[1.15,0,-.75],'Re{z}'],[[0,-1.12,-.75],[0,1.15,-.75],'Im{z}']];
    for(const [a,b,label] of axes){const p=project3D(...a,width,height),q=project3D(...b,width,height);ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.stroke();ctx.fillText(label,q.x+5*dpr,q.y-5*dpr);}
  }

  const formatComplex=(re,im)=> { re=clean(re); im=clean(im); if(im===0)return `${re}`; if(re===0)return `${im}j`; return `${re} ${im<0?'−':'+'} ${Math.abs(im)}j`; };
  const factor=(p)=>{ const c=formatComplex(p.re,p.im); return p.im===0&&p.re>=0?`(z − ${p.re})${p.order>1?'^'+p.order:''}`:`(z − (${c}))${p.order>1?'^'+p.order:''}`; };
  const polyFrom=(roots)=>{ let a=[{re:1,im:0}]; for(const p of roots) for(let k=0;k<p.order;k++){const b=Array(a.length+1).fill(0).map(()=>({re:0,im:0}));a.forEach((c,i)=>{b[i].re+=c.re;b[i].im+=c.im;b[i+1].re-=c.re*p.re-c.im*p.im;b[i+1].im-=c.re*p.im+c.im*p.re;});a=b;} return a; };
  const polyText=(name,a)=>`${name}(z) = `+a.map((c,i)=>{const pow=a.length-1-i, coeff=formatComplex(c.re,c.im);return `${i?' + ':''}(${coeff})${pow?`z${pow>1?'^'+pow:''}`:''}`;}).join('').replaceAll('+ (−','− (');
  function renderEquation(){const zeros=points.filter(p=>p.type==='zero'),poles=points.filter(p=>p.type==='pole');root.querySelector('[data-numerator]').textContent=zeros.length?zeros.map(factor).join(' '):'1';root.querySelector('[data-denominator]').textContent=poles.length?poles.map(factor).join(' '):'1';root.querySelector('[data-b-poly]').textContent=polyText('B',polyFrom(zeros));root.querySelector('[data-a-poly]').textContent=polyText('A',polyFrom(poles));}
  function renderList(){ pointList.replaceChildren(); if(!points.length){const e=document.createElement('p');e.className='empty';e.textContent='Chưa có điểm. Click lên mặt phẳng hoặc nhập tọa độ ở trên.';pointList.append(e);return;} points.forEach((p,index)=>{const row=document.createElement('div');row.className=`point-row ${p.type}`;const paired=realSystem&&Math.abs(p.im)>.005;row.innerHTML=`<span class="point-symbol" aria-hidden="true">${p.type==='zero'?'○':'×'}</span><strong>${p.type==='zero'?'Zero':'Pole'} ${index+1}${paired?' ↔':''}</strong><label>Re <input type="number" step="0.01" min="-${domain}" max="${domain}" value="${p.re}"></label><label>Im <input type="number" step="0.01" min="-${domain}" max="${domain}" value="${p.im}"></label><label>Bậc <input type="number" step="1" min="1" max="9" value="${p.order}"></label><button type="button" aria-label="Xóa ${p.type} ${index+1}${paired?' và điểm liên hợp':''}">Xóa</button>`;const inputs=row.querySelectorAll('input');inputs.forEach((input,i)=>input.addEventListener('change',()=>{const v=Number(input.value);if(!Number.isFinite(v))return;if(i===0)p.re=clean(clamp(v,-domain,domain));if(i===1)p.im=clean(clamp(v,-domain,domain));if(i===2)p.order=clamp(Math.round(v),1,9);syncPair(p);update();}));row.querySelector('button').addEventListener('click',()=>{points=points.filter(q=>q.id!==p.id&&(!realSystem||q.group!==p.group));update();});pointList.append(row);});}
  const cAdd=(a,b)=>({re:a.re+b.re,im:a.im+b.im});
  const cMul=(a,b)=>({re:a.re*b.re-a.im*b.im,im:a.re*b.im+a.im*b.re});
  const impulseResponse=()=>{
    const b=polyFrom(points.filter(p=>p.type==='zero'));
    const a=polyFrom(points.filter(p=>p.type==='pole'));
    const h=[];
    for(let n=0;n<sampleCount;n++){
      let value=n<b.length?{...b[n]}:{re:0,im:0};
      for(let k=1;k<a.length&&k<=n;k++){
        const feedback=cMul(a[k],h[n-k]);
        value=cAdd(value,{re:-feedback.re,im:-feedback.im});
      }
      h.push(value);
    }
    return h;
  };
  function describeMode(){
    const poles=points.filter(p=>p.type==='pole');
    if(!poles.length)return '<strong>FIR:</strong> không có pole hữu hạn; đáp ứng chỉ do các zero quyết định.';
    const maxRadius=Math.max(...poles.map(p=>Math.hypot(p.re,p.im)));
    const stability=maxRadius<.995?'ổn định — biên độ tắt dần':maxRadius<=1.005?'biên giới ổn định — mode không tắt':'không ổn định — biên độ tăng';
    const features=[];
    if(poles.some(p=>Math.abs(p.im)>.005))features.push('pole phức tạo dao động');
    if(poles.some(p=>Math.abs(p.im)<=.005&&p.re<0))features.push('pole thực âm làm mẫu đổi dấu');
    if(poles.some(p=>p.order>1))features.push('cực bội sinh thêm thừa số đa thức theo n');
    if(!features.length)features.push('pole thực dương tạo exponential không đổi dấu');
    return `<strong>${stability}</strong> · r<sub>max</sub> = ${maxRadius.toFixed(3)} · ${features.join(' · ')}`;
  }
  function drawStem(){
    const {ctx,width,height,dpr}=fitCanvas(stem), bg=css('--sl-color-bg','#0b111c'), fg=css('--sl-color-text','#e7edf7'), grid=css('--sl-color-gray-5','#526076');
    const realColor=css('--sl-color-accent-high','#54d2d2'), imagColor=css('--sl-color-orange-high','#ff9d55');
    const h=impulseResponse(), padL=54*dpr,padR=18*dpr,padT=22*dpr,padB=42*dpr,plotW=width-padL-padR,plotH=height-padT-padB;
    let peak=Math.max(1e-9,...h.flatMap(v=>[Math.abs(v.re),Math.abs(v.im)]));
    const clipped=peak>1e4; peak=Math.min(peak,1e4);
    const yMax=peak*1.12, xAt=n=>padL+(h.length===1?0:n/(h.length-1))*plotW, yAt=v=>padT+plotH/2-v/yMax*plotH/2;
    ctx.clearRect(0,0,width,height);ctx.fillStyle=bg;ctx.fillRect(0,0,width,height);
    ctx.strokeStyle=grid;ctx.globalAlpha=.42;ctx.lineWidth=dpr;
    for(let t=-1;t<=1;t+=.5){const y=yAt(t*yMax);ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(width-padR,y);ctx.stroke();}
    ctx.globalAlpha=.9;ctx.strokeStyle=fg;ctx.beginPath();ctx.moveTo(padL,yAt(0));ctx.lineTo(width-padR,yAt(0));ctx.stroke();
    const drawSeries=(key,color,offset)=>{ctx.strokeStyle=color;ctx.fillStyle=color;ctx.lineWidth=1.6*dpr;h.forEach((v,n)=>{const raw=v[key],value=clamp(raw,-1e4,1e4),x=xAt(n)+offset*dpr,y=yAt(value);ctx.beginPath();ctx.moveTo(x,yAt(0));ctx.lineTo(x,y);ctx.stroke();ctx.beginPath();ctx.arc(x,y,3.6*dpr,0,Math.PI*2);ctx.fill();});};
    drawSeries('re',realColor,-2);if(h.some(v=>Math.abs(v.im)>1e-7))drawSeries('im',imagColor,2);
    ctx.fillStyle=fg;ctx.globalAlpha=.8;ctx.font=`${11*dpr}px system-ui`;ctx.textAlign='center';
    const tickStep=h.length>60?10:h.length>32?5:2;for(let n=0;n<h.length;n+=tickStep)ctx.fillText(String(n),xAt(n),height-15*dpr);
    ctx.textAlign='left';ctx.fillText(`±${yMax.toPrecision(3)}`,5*dpr,padT+10*dpr);ctx.textAlign='right';ctx.fillText('n',width-padR,height-15*dpr);
    if(clipped){ctx.fillStyle=imagColor;ctx.textAlign='right';ctx.fillText('Biên độ đã cắt tại 10⁴ để còn quan sát được',width-padR,padT+10*dpr);}
    root.querySelector('[data-mode-summary]').innerHTML=describeMode();
  }
  function update(list=true){drawPlane();drawSurface();drawStem();renderEquation();if(list)renderList();}

  plane.addEventListener('pointerdown',(event)=>{const hit=eventPointHit(event);if(hit){draggedId=hit.id;plane.setPointerCapture(event.pointerId);pointMenu.hidden=true;}else{pending=planeCoord(event);const wrap=root.querySelector('.plane-wrap').getBoundingClientRect();pointMenu.style.left=`${clamp(event.clientX-wrap.left+12,8,wrap.width-190)}px`;pointMenu.style.top=`${clamp(event.clientY-wrap.top+12,8,wrap.height-190)}px`;root.querySelector('[data-menu-coordinate]').textContent=`${formatComplex(pending.re,pending.im)}`;pointMenu.hidden=false;root.querySelector('[data-menu-type]').focus();}});
  plane.addEventListener('pointermove',(event)=>{if(draggedId===null)return;const p=points.find(q=>q.id===draggedId);if(p){const q=planeCoord(event);p.re=q.re;p.im=q.im;syncPair(p);update(false);}});
  plane.addEventListener('pointerup',()=>{if(draggedId!==null){draggedId=null;renderList();renderEquation();}});
  plane.addEventListener('keydown',(event)=>{if(!points.length)return;const p=points[points.length-1],step=event.shiftKey?.1:.02;if(event.key==='ArrowLeft')p.re=clamp(p.re-step,-domain,domain);else if(event.key==='ArrowRight')p.re=clamp(p.re+step,-domain,domain);else if(event.key==='ArrowUp')p.im=clamp(p.im+step,-domain,domain);else if(event.key==='ArrowDown')p.im=clamp(p.im-step,-domain,domain);else return;event.preventDefault();syncPair(p);update();});
  pointMenu.addEventListener('submit',(event)=>{event.preventDefault();if(!pending)return;addPoint(root.querySelector('[data-menu-type]').value,pending.re,pending.im,Number(root.querySelector('[data-menu-order]').value));pointMenu.hidden=true;update();});
  root.querySelector('[data-menu-cancel]').addEventListener('click',()=>pointMenu.hidden=true);
  root.querySelector('[data-manual-form]').addEventListener('submit',(event)=>{event.preventDefault();const re=Number(root.querySelector('[data-manual-re]').value),im=Number(root.querySelector('[data-manual-im]').value),order=Number(root.querySelector('[data-manual-order]').value);if(!Number.isFinite(re)||!Number.isFinite(im)||!Number.isFinite(order))return;addPoint(root.querySelector('[data-manual-type]').value,re,im,order);update();});
  root.querySelector('[data-clear]').addEventListener('click',()=>{points=[];update();});
  root.querySelector('[data-clear-zeros]').addEventListener('click',()=>{points=points.filter(p=>p.type!=='zero');update();});
  const presets={
    positive:[{re:.72,im:0,order:1}],
    negative:[{re:-.72,im:0,order:1}],
    complex:[{re:.78,im:.55,order:1},{re:.78,im:-.55,order:1}],
    unit:[{re:.81,im:.59,order:1},{re:.81,im:-.59,order:1}],
    outside:[{re:1.12,im:0,order:1}],
    repeated:[{re:.78,im:0,order:2}],
  };
  root.querySelectorAll('[data-preset]').forEach(button=>button.addEventListener('click',()=>{
    const spec=presets[button.dataset.preset];points=[];const group=nextGroup++;
    spec.forEach((p)=>points.push({id:nextId++,group:spec.length===2?group:nextGroup++,type:'pole',...p}));
    realSystem=true;root.querySelector('[data-system-type]').value='real';update();
  }));
  root.querySelector('[data-sample-count]').addEventListener('change',(event)=>{sampleCount=clamp(Math.round(Number(event.target.value)||40),12,96);event.target.value=sampleCount;drawStem();});
  surface.addEventListener('pointerdown',(e)=>{surfaceDrag={x:e.clientX,y:e.clientY};surface.setPointerCapture(e.pointerId);});
  surface.addEventListener('pointermove',(e)=>{if(!surfaceDrag)return;yaw+=(e.clientX-surfaceDrag.x)*.008;pitch=clamp(pitch+(e.clientY-surfaceDrag.y)*.008,.2,1.35);surfaceDrag={x:e.clientX,y:e.clientY};root.querySelector('[data-view-state]').textContent='Đã xoay';drawSurface();});
  surface.addEventListener('pointerup',()=>surfaceDrag=null);
  surface.addEventListener('keydown',(e)=>{if(e.key==='ArrowLeft')yaw-=.08;else if(e.key==='ArrowRight')yaw+=.08;else if(e.key==='ArrowUp')pitch=clamp(pitch-.08,.2,1.35);else if(e.key==='ArrowDown')pitch=clamp(pitch+.08,.2,1.35);else return;e.preventDefault();root.querySelector('[data-view-state]').textContent='Đã xoay';drawSurface();});
  root.querySelector('[data-reset-view]').addEventListener('click',()=>{surfaceDrag=null;yaw=defaultYaw;pitch=defaultPitch;root.querySelector('[data-view-state]').textContent='Góc mặc định';drawSurface();});
  root.querySelector('[data-system-type]').addEventListener('change',(event)=>{realSystem=event.target.value==='real';if(realSystem)enforceRealSystem();update();});
  const setResolution=(value)=>{resolution=clamp(value,19,67);root.querySelector('[data-resolution]').textContent=`${resolution} × ${resolution}`;root.querySelector('[data-resolution-down]').disabled=resolution<=19;root.querySelector('[data-resolution-up]').disabled=resolution>=67;drawSurface();};
  root.querySelector('[data-resolution-down]').addEventListener('click',()=>setResolution(resolution-8));
  root.querySelector('[data-resolution-up]').addEventListener('click',()=>setResolution(resolution+8));
  new ResizeObserver(()=>update(false)).observe(root);
  update();
</script>

